@startuml
title Sequenza di calibrazione IMU

skinparam ParticipantPadding 30
skinparam BoxPadding 10
skinparam sequenceArrowThickness 2

legend top right
|= Freccia |= Significato |
| -> | Chiamata sincrona |
| --> | Evento asincrono |
endlegend

actor App

participant "B L E" as BLE
participant "Task\nCalibrazione" as CAL
participant "Task\nProducer IMU" as PROD
database "Coda\nCalibrazione" as QUEUE
database "Configurazione\n+ SD" as STORAGE

App -> BLE : Richiede calibrazione
BLE --> CAL : Notifica avvio

CAL -> CAL : Inizializza calibrazione\n(svuota coda, abilita acquisizione)

par Acquisizione dati
    loop Durante la calibrazione
        PROD -> QUEUE : Pubblica campioni IMU
    end
else Elaborazione
    CAL -> QUEUE : Consuma campioni
    CAL -> CAL : Calcola bias e vettore "UP" (step 1)
    CAL -> CAL : Calcola vettore "RIGHT" (step 2)
    CAL -> CAL : Calcola vettore "FORWARD" (step 3)
end

CAL -> STORAGE : Salva dati di calibrazione
STORAGE --> CAL : Conferma

CAL --> BLE : Esito calibrazione
BLE --> App : Notifica SUCCESS / ERROR

@enduml

@startuml
title Sequenza di calibrazione IMU

skinparam ParticipantPadding 30
skinparam BoxPadding 10
skinparam sequenceArrowThickness 2

legend top right
|= Freccia |= Significato |
| -> | Chiamata sincrona |
| --> | Evento asincrono |
endlegend

actor App

participant "B L E" as BLE
participant "Task\nCalibrazione" as CAL
participant "Task\nProducer IMU" as PROD
database "Coda\nCalibrazione" as QUEUE
database "Configurazione\n+ SD" as STORAGE

App -> BLE : Richiede calibrazione
BLE --> CAL : Notifica avvio

CAL -> CAL : Inizializza calibrazione\n(svuota coda, abilita acquisizione)

loop Per ciascuno dei 3 step (UP, RIGHT, FORWARD)
    CAL --> BLE : Richiede esecuzione movimento
    BLE --> App : Mostra istruzione dello step corrente

    par Acquisizione dati
        loop Durante l'acquisizione dello step
            PROD -> QUEUE : Pubblica campioni IMU
        end
    else Elaborazione
        CAL -> QUEUE : Consuma campioni
        CAL -> CAL : Calcola vettore dello step corrente
    end

    alt Dati insufficienti o non conformi
        CAL --> BLE : Segnala step non valido
        BLE --> App : Richiede di ripetere il movimento
    else Dati validi
        CAL -> CAL : Conferma step e passa al successivo
    end
end

CAL -> STORAGE : Salva dati di calibrazione
STORAGE --> CAL : Conferma

CAL --> BLE : Esito calibrazione
BLE --> App : Notifica SUCCESS / ERROR

@enduml